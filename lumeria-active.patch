+.steps {
+    display: grid;
+    gap: 1rem;
+    grid-template-columns: 1fr;
+    counter-reset: step;
+}
+@media (min-width: 820px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+.step {
+    position: relative;
+    padding: clamp(1.25rem, 3vw, 1.75rem);
+    border: 1px solid var(--lumeria-border);
+    border-radius: var(--radius-md);
+    background: var(--lumeria-card);
+    display: flex;
+    flex-direction: column;
+    gap: .5rem;
+}
+.step-num {
+    font-family: var(--font-display);
+    font-size: 2.1rem;
+    line-height: 1;
+    color: var(--lumeria-gold);
+}
+.step h3 {
+    margin: 0;
+    font-family: var(--font-display);
+    font-size: 1.2rem;
+    font-weight: 600;
+}
+.step p {
+    margin: 0;
+    font-size: .9rem;
+    line-height: 1.6;
+    color: var(--lumeria-muted);
+}
+
+/* FAQ memakai <details> sehingga tetap bisa dibuka tanpa JavaScript */
+.faq-list {
+    display: grid;
+    gap: 0;
+    border-top: 1px solid var(--lumeria-border);
+}
+.faq-item {
+    border-bottom: 1px solid var(--lumeria-border);
+}
+.faq-item summary {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1.25rem;
+    padding: 1.15rem .25rem;
+    cursor: pointer;
+    list-style: none;
+    font-weight: 600;
+    font-size: clamp(.98rem, 1.9vw, 1.08rem);
+    color: var(--lumeria-ink);
+}
+.faq-item summary::-webkit-details-marker { display: none; }
+.faq-item summary:hover { color: var(--lumeria-dark); }
+.faq-mark {
+    position: relative;
+    flex: none;
+    width: 1.6rem;
+    height: 1.6rem;
+    border-radius: 50%;
+    border: 1px solid var(--lumeria-border);
+    background: var(--lumeria-card);
+}
+.faq-mark::before,
+.faq-mark::after {
+    content: "";
+    position: absolute;
+    top: 50%;
+    left: 50%;
+    width: .7rem;
+    height: 1.5px;
+    background: var(--lumeria-ink);
+    transform: translate(-50%, -50%);
+    transition: transform .25s var(--ease);
+}
+.faq-mark::after { transform: translate(-50%, -50%) rotate(90deg); }
+.faq-item[open] .faq-mark::after { transform: translate(-50%, -50%) rotate(0deg); }
+.faq-answer {
+    padding: 0 2.5rem 1.35rem .25rem;
+    margin: 0;
+    font-size: .95rem;
+    line-height: 1.7;
+    color: var(--lumeria-muted);
+    max-width: 52rem;
+}
+
+
+/* ==========================================================================
+   11. GALERI, PITA AJAKAN, AKSESIBILITAS
+   ========================================================================== */
+.gallery-grid {
+    display: grid;
+    gap: clamp(.6rem, 1.6vw, 1rem);
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+@media (min-width: 780px) {
+    .gallery-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+}
+.gallery-item {
+    position: relative;
+    overflow: hidden;
+    border-radius: var(--radius-md);
+    background: var(--lumeria-surface-soft);
+    aspect-ratio: 1 / 1;
+}
+.gallery-item:first-child {
+    grid-column: span 2;
+    aspect-ratio: 2 / 1.16;
+}
+@media (min-width: 780px) {
+    .gallery-item:first-child { grid-column: span 2; grid-row: span 2; aspect-ratio: 1 / 1; }
+}
+.gallery-item img {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+    transition: transform .8s var(--ease);
+}
+.gallery-item:hover img { transform: scale(1.04); }
+
+.cta-band {
+    position: relative;
+    overflow: hidden;
+    background:
+        radial-gradient(38rem 26rem at 85% 15%, color-mix(in srgb, var(--lumeria-accent) 18%, transparent), transparent 70%),
+        var(--lumeria-darker);
+    color: var(--lumeria-surface);
+    border-radius: clamp(1.25rem, 3vw, 2rem);
+    padding: clamp(2rem, 6vw, 4rem);
+    text-align: center;
+}
+.cta-band .eyebrow { color: color-mix(in srgb, var(--lumeria-surface) 70%, transparent); }
+.cta-band .section-title { color: var(--lumeria-surface); margin-inline: auto; max-width: 30ch; }
+.cta-band p {
+    color: color-mix(in srgb, var(--lumeria-surface) 78%, transparent);
+    max-width: 34rem;
+    margin: .9rem auto 0;
+}
+.cta-band .btn-outline-dark {
+    --bs-btn-color: var(--lumeria-surface);
+    --bs-btn-border-color: color-mix(in srgb, var(--lumeria-surface) 45%, transparent);
+    --bs-btn-hover-color: var(--lumeria-darker);
+    --bs-btn-hover-bg: var(--lumeria-surface);
+    --bs-btn-hover-border-color: var(--lumeria-surface);
+}
+.cta-actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: .75rem;
+    margin-top: 1.6rem;
+}
+
+.skip-link {
+    position: absolute;
+    left: .75rem;
+    top: -4rem;
+    z-index: 2000;
+    padding: .5rem 1rem;
+    border-radius: .5rem;
+    background: var(--lumeria-card);
+    color: var(--lumeria-dark);
+    box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .2);
+    transition: top .15s ease;
+}
+.skip-link:focus { top: .75rem; }
+
+main:focus { outline: none; }
+[id^="product-"] { scroll-margin-top: 7rem; }
+[id] { scroll-margin-top: 7rem; }
+
+:focus-visible { outline: 3px solid var(--lumeria-ring); outline-offset: 2px; }
+
+/* Tombol keranjang melayang (layar kecil) */
+.cart-fab {
+    position: fixed;
+    right: 1rem;
+    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
+    z-index: 1030;
+    display: inline-flex;
+    align-items: center;
+    gap: .5rem;
+    padding: .75rem 1.15rem;
+    box-shadow: 0 1rem 2rem -1rem rgba(19, 34, 56, .7);
+}
+@media (max-width: 1199.98px) {
+    .has-fab main { padding-bottom: 4.5rem; }
+}
+
+/* Toast status */
+.toast {
+    border-radius: .9rem;
+    box-shadow: 0 1.5rem 3rem -1.5rem rgba(19, 34, 56, .6);
+    font-size: .92rem;
+}
+.toast.text-bg-success {
+    background-color: var(--lumeria-darker) !important;
+    color: var(--lumeria-surface) !important;
 }
 
 
 /* ==========================================================================
-   7. Prefers-reduced-motion
+   12. PREFERS-REDUCED-MOTION
    ========================================================================== */
 @media (prefers-reduced-motion: reduce) {
     html { scroll-behavior: auto; }
-    .product-card, .product-art svg, .skip-link { transition: none; }
-    .product-card:hover, .product-card:hover .product-art svg { transform: none; }
+    .ticker-track { animation: none; }
+    .f-card-media img,
+    .cat-card img,
+    .gallery-item img,
+    .btn,
+    .link-arrow { transition: none; }
+    .btn:hover,
+    .product-card:hover { transform: none; }
 }
