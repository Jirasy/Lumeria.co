diff --git a/public/css/lumeria-redesign.css b/public/css/lumeria-redesign.css
new file mode 100644
index 0000000..0bb9308
--- /dev/null
+++ b/public/css/lumeria-redesign.css
@@ -0,0 +1,605 @@
+/* ==========================================================================
+   Lumeria.co - komponen etalase foodtech
+   Dimuat SETELAH public/css/lumeria.css. Semua warna memakai token dari
+   lumeria.css bagian 1, kecuali tiga warna bola pada kotak catering.
+
+   Daftar isi
+     1. Kartu produk dan badge
+     2. Carousel produk
+     3. Kartu Event & Catering
+     4. Halaman detail produk
+     5. Footer
+     6. Keranjang, riwayat pesanan, dan panel admin
+     7. Prefers-reduced-motion
+   ========================================================================== */
+
+
+/* 1. Kartu produk dan badge ------------------------------------------------ */
+.product-card {
+    width: 100%;
+    overflow: hidden;
+    border: 1px solid var(--lumeria-border);
+    border-radius: var(--radius-md);
+    background: var(--lumeria-card);
+    box-shadow: none;
+    transition: transform .3s var(--ease), box-shadow .3s var(--ease),
+                border-color .3s var(--ease);
+}
+.product-card:hover {
+    transform: translateY(-4px);
+    border-color: color-mix(in srgb, var(--lumeria-ink) 18%, var(--lumeria-border));
+    box-shadow: 0 1.75rem 3rem -1.75rem color-mix(in srgb, var(--lumeria-ink) 35%, transparent);
+}
+
+.ft-media { position: relative; }
+
+.ft-badge {
+    position: absolute;
+    top: .85rem;
+    left: .85rem;
+    z-index: 3;
+    padding: .32rem .7rem;
+    border-radius: var(--radius-pill);
+    font-size: .68rem;
+    font-weight: 600;
+    letter-spacing: .12em;
+    text-transform: uppercase;
+    line-height: 1.3;
+    box-shadow: 0 .25rem .75rem -0.25rem rgba(19, 34, 56, .35);
+}
+.ft-badge-hot  { background: var(--lumeria-ink); color: var(--lumeria-surface); }
+.ft-badge-soft { background: var(--lumeria-accent); color: var(--lumeria-on-accent); }
+
